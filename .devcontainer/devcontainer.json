{
  "name": "Linux 入門（AlmaLinux 10）",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--privileged"
  ],
  "overrideCommand": false,
  "containerUser": "root",
  "remoteUser": "student",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontSize": 16,
        "terminal.integrated.gpuAcceleration": "off"
      }
    }
  }
}
